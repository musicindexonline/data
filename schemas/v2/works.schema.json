{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicindexonline.github.io/data/schemas/v2/works.schema.json",
  "title": "Music Index Online works",
  "type": "array",
  "definitions": {
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "composerId",
      "title",
      "genre",
      "movements"
    ],
    "properties": {
      "composerId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "preferred"
        ],
        "properties": {
          "preferred": {
            "type": "string",
            "minLength": 1
          },
          "alias": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "identifiers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog",
            "value"
          ],
          "properties": {
            "catalog": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "display": {
              "type": "string",
              "minLength": 1
            },
            "primary": {
              "type": "boolean"
            }
          }
        }
      },
      "medium": {
        "$ref": "#/definitions/stringSet"
      },
      "genre": {
        "type": "string",
        "minLength": 1
      },
      "key": {
        "$ref": "#/definitions/stringSet"
      },
      "period": {
        "type": "string",
        "enum": [
          "Baroque",
          "Classical",
          "Romantic",
          "Modern"
        ]
      },
      "movements": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "$ref": "#/definitions/stringSet"
            },
            "medium": {
              "$ref": "#/definitions/stringSet"
            }
          }
        }
      }
    }
  }
}
