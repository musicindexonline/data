{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicindexonline.github.io/data/schemas/v2/composer.schema.json",
  "title": "Music Index Online composers",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "shortName"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "shortName": {
        "type": "string",
        "minLength": 1
      },
      "defaultPeriod": {
        "type": "string",
        "enum": [
          "Baroque",
          "Classical",
          "Romantic",
          "Modern"
        ]
      }
    }
  }
}
