{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicindexonline.github.io/data/schemas/v1/music.schema.json",
  "title": "Music Index Online works",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "composer",
      "title",
      "op",
      "genre",
      "period",
      "movements"
    ],
    "properties": {
      "composer": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "op": {
        "type": "string"
      },
      "genre": {
        "type": "string",
        "minLength": 1
      },
      "period": {
        "type": "string",
        "minLength": 1
      },
      "movements": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
